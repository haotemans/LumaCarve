{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumaCarve",
  "version": "0.2.0",
  "identifier": "io.github.haotemans.lumacarve",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LumaCarve · 琢影",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#F4F6FB"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: http://tauri.localhost; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/lumacarve-api"
    ]
  }
}
