{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "vite/client"
    ],
    "jsx": "preserve"
  },
  "include": [
    "src/main.ts",
    "src/vue/**/*.ts",
    "src/vue/**/*.vue",
    "src/vue/**/*.d.ts",
    "vite.config.ts"
  ]
}
